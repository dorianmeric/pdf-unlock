# This file is a template. At container start the nginx image's
# /docker-entrypoint.d/20-envsubst-on-templates.sh renders it to
# /etc/nginx/conf.d/default.conf, replacing ${PORT} with the value of the
# PORT environment variable (default 8191, set in the Dockerfile).
# Because the container runs with a read-only root filesystem, that output
# directory is mounted as a tmpfs (see docker-compose.yml).
server {
    # nginx cannot read env vars itself, so the port arrives via envsubst above.
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # MIME types come from the image's /etc/nginx/mime.types (which already maps
    # application/wasm), so do not redeclare `types` here: a nested block would
    # replace the inherited map and turn every other file into octet-stream.

    charset utf-8;
    server_tokens off;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json application/wasm image/svg+xml;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    # Hashed build output can be cached forever.
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
    }

    # The entry document must always be revalidated so new builds are picked up.
    location = /index.html {
        expires -1;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
    }

    # Single-page app: everything else falls back to the shell.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
